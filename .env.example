# Copy to .env and fill in. .env is gitignored and never committed.
# Compose reads this file for variable substitution and injects it into the
# application services, so it is the single place runtime settings live.

# Infrastructure credentials
POSTGRES_PASSWORD=change_me
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_ADMIN_PASSWORD=change_me
GRAFANA_ADMIN_USER=admin
# Only applied when the grafana-data volume is first created. Changing it
# later needs `docker compose down -v grafana` or a password reset in the UI.
GRAFANA_ADMIN_PASSWORD=change_me

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=events_db
POSTGRES_USER=eventpipeline

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Seconds between polls of each source. GDELT publishes every ~15 minutes and
# rate-limits aggressively; NewsAPI's free tier allows 100 requests a day.
NEWSAPI_INTERVAL=900
REDDIT_INTERVAL=300
GDELT_INTERVAL=900

# Source APIs. Sources without credentials fall back to mock data.
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=EventPipeline/1.0

# Alerting. Channels without credentials are simply disabled.
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
MIN_ALERT_SEVERITY=medium
